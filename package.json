{
  "name": "customparadigm",
  "version": "0.1.0",
  "description": "Custom tooling on top of the Paradigm ERP REST API.",
  "main": "src/server.js",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "query": "node --env-file-if-exists=.env src/cli.js",
    "test": "node --test",
    "gen:endpoints": "node --env-file-if-exists=.env scripts/gen-endpoints.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  }
}
