# Paradigm API host (client-specific), without the trailing /api
PARADIGM_BASE_URL=https://yourcompany.paradigmerp.example
# API key, sent as the x-api-key header. Full access, so keep it secret.
PARADIGM_API_KEY=

# Port for the local web server
PORT=3000
# Basic-auth password that protects the web server. Required in production.
APP_PASSWORD=
